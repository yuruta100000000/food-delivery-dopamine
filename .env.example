# OpenAI API(スクショ解析)。未設定でもアプリは動くが、AI解析は503を返し手動入力にフォールバックする
OPENAI_API_KEY=
# 解析モデル(省略時 gpt-4.1-mini)。精度が足りなければ gpt-4.1 等に変更
# OPENAI_MODEL=gpt-4.1-mini

# --- Supabase(任意)。未設定時は端末のlocalStorageに保存される ---
# 設定手順: supabase/schema.sql をSQL Editorで実行し、Anonymous sign-insを有効化
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# parse_logs保存用(サーバー専用・公開しないこと)
# SUPABASE_SERVICE_ROLE_KEY=

# --- シェアカード(任意)。本番URL。未設定時はVercelの本番URLを自動使用 ---
# NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# --- 先行課金(W4)。Stripe Payment LinkのURLを設定するとダッシュボードに応援ボタンが出る ---
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
